<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="PlayerHealthBackground" style="flex-grow: 1; width: 400px; height: 70px; position: absolute; left: 40%; right: 0%; top: 82%; background-color: rgb(0, 0, 0); -unity-text-auto-size: best-fit 10px 24px; -unity-text-generator: standard; color: rgb(255, 255, 255); -unity-text-align: upper-center; border-left-color: rgb(0, 255, 60); border-right-color: rgb(0, 255, 60); border-top-color: rgb(0, 255, 60); border-bottom-color: rgb(0, 255, 60); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
        <ui:VisualElement name="HealthbarFill" style="flex-grow: 1; background-color: rgb(16, 135, 0); position: absolute; height: 100%; width: 100%;"/>
        <ui:Label text="Player&#10;&#10;" style="height: auto; top: auto; width: auto; font-size: 40px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="CrystalHealthBackground" style="flex-grow: 1; width: 400px; height: 70px; position: absolute; left: 40%; right: 0%; top: 90%; background-color: rgb(0, 0, 0); -unity-text-auto-size: best-fit 10px 24px; -unity-text-generator: standard; color: rgb(255, 255, 255); -unity-text-align: upper-center; border-left-color: rgb(132, 236, 253); border-right-color: rgb(132, 236, 253); border-top-color: rgb(132, 236, 253); border-bottom-color: rgb(132, 236, 253); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;">
        <ui:VisualElement name="HealthbarFill" style="flex-grow: 1; background-color: rgb(0, 107, 135); position: absolute; height: 100%; width: 100%;"/>
        <ui:Label text="Crystal" style="height: auto; top: auto; width: auto; font-size: 40px;"/>
    </ui:VisualElement>
</ui:UXML>
